{
  "name": "codx-hub-cli",
  "version": "2.0.0",
  "description": "Manage Codex CLI profiles, hooks, sessions, and providers",
  "type": "module",
  "bin": {
    "codx": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:build": "npm test && npm run build"
  },
  "keywords": [
    "codex",
    "cli",
    "profiles",
    "hooks",
    "sessions",
    "providers",
    "kimi",
    "qianwen"
  ],
  "dependencies": {
    "@types/ws": "^8.18.1",
    "commander": "^13.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^3.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "license": "MIT"
}
